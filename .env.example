# Copy this file to .env and generate a unique value for each secret.
# APP_SECRET_KEY must contain at least 32 characters. Do not commit .env.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
APP_SECRET_KEY=

# Authentication policy (optional; defaults shown)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
ADMIN_MFA_REQUIRED=false
MFA_CHALLENGE_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5
STEP_UP_TTL_SECONDS=300
# Production must use the public portal host and HTTPS origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PVE Master
WEBAUTHN_ORIGIN=http://localhost:3000

# Notification delivery. Webhooks require explicit public host/network allowlisting.
NOTIFICATION_WEBHOOK_ALLOWED_HOSTS='["hooks.example.com"]'
NOTIFICATION_WEBHOOK_ALLOWED_NETWORKS='[]'
NOTIFICATION_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
SESSION_COOKIE_SECURE=false

PVE_CONNECT_TIMEOUT_SECONDS=5
PVE_READ_TIMEOUT_SECONDS=15
PVE_MAX_CONNECTIONS=20
PVE_MAX_KEEPALIVE_CONNECTIONS=10
# At least one exact hostname or management CIDR must allow every Proxmox endpoint.
PVE_ALLOWED_HOSTS='["pve.example.internal"]'
PVE_ALLOWED_NETWORKS='["10.0.0.0/8"]'
PVE_TASK_POLL_INTERVAL_SECONDS=2
PVE_TASK_TIMEOUT_SECONDS=300
PVE_TASK_MAX_POLL_ATTEMPTS=150
PVE_ACTION_MAX_ATTEMPTS=3
OPERATION_LEASE_SECONDS=60

# Operations and alerting policy
WORKER_HEARTBEAT_TTL_SECONDS=60
QUEUE_BACKLOG_ALERT_THRESHOLD=100
IP_POOL_LOW_AVAILABLE_THRESHOLD=5
PROVISIONING_FAILURE_ALERT_COUNT=3
PROVISIONING_FAILURE_WINDOW_MINUTES=30
AUDIT_RETENTION_DAYS=365
REFRESH_TOKEN_RETENTION_DAYS=30
COMPLETED_RUN_RETENTION_DAYS=7
SYNC_RUN_RETENTION_DAYS=30
SCHEDULER_LEASE_SECONDS=55
OPERATION_WATCHDOG_SECONDS=120
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_MAX_BACKOFF_SECONDS=300
INVENTORY_STALE_AFTER_SECONDS=180

# Advanced operations are independent kill switches and default to disabled.
ADVANCED_SNAPSHOT_ENABLED=false
ADVANCED_MIGRATION_ENABLED=false
ADVANCED_HA_ENABLED=false
ADVANCED_NODE_MAINTENANCE_ENABLED=false
ADVANCED_BULK_ENABLED=false
ADVANCED_GUEST_CONFIG_ENABLED=false
ADVANCED_FIREWALL_SDN_ENABLED=false
