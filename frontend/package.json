{
  "name": "pvemaster-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --experimental-strip-types --test tests/*.e2e.test.ts",
    "test:mock": "node --experimental-strip-types --test tests/*.e2e.test.ts",
